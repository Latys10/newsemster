using namespace std;

HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);

void color(int c) { SetConsoleTextAttribute(hConsole, c); }

const int WHITE = 7;
const int RED = 12;
const int BLUE = 9;
const int GREEN = 10;
const int YELLOW = 14;

const string VOWELS = "\xE0\xE5\xB8\xE8\xEE\xF3\xFB\xFD\xFE\xFF";
const string CONSONANTS = "\xE1\xE2\xE3\xE4\xE6\xE7\xE9\xEA\xEB\xEC\xED\xEF\xF0\xF1\xF2\xF4\xF5\xF6\xF7\xF8\xF9\xFA\xFC";

char toLowerRus(char c) {
    unsigned char u = (unsigned char)c;
    if (u >= 192 && u <= 223) return (char)(u + 32);
    if (u == 168) return (char)184;
    return c;
}

bool isVowel(char c) { return VOWELS.find(toLowerRus(c)) != string::npos; }
bool isConsonant(char c) { return CONSONANTS.find(toLowerRus(c)) != string::npos; }
bool isDigit(char c) { return c >= '0' && c <= '9'; }
bool isLatin(char c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); }
bool isSymbol(char c) {
    if (c == '@') return false;
    if (isVowel(c) || isConsonant(c)) return false;
    if (isDigit(c)) return false;
    if (isLatin(c)) return false;
    return true;
}

// КЛАСС ЗУБЧАТОГО МАССИВА
class JaggedArray {
private:
    vector<vector<char>> data;

    // класс для A[i][j]
    class RowProxy {
    private:
        vector<char>& row;
    public:
        RowProxy(vector<char>& r) : row(r) {}

        // второй operator[] — возвращает ссылку на элемент
        char& operator[](int j) {
            if (j < 0 || j >= (int)row.size())
                throw out_of_range("Индекс столбца вне диапазона");
            return row[j];
        }
        const char& operator[](int j) const {
            if (j < 0 || j >= (int)row.size())
                throw out_of_range("Индекс столбца вне диапазона");
            return row[j];
        }

        int size() const { return (int)row.size(); }
    };

public:
    JaggedArray() {}

    // Конструктор из строки — распределяет символы по 4 строкам
    JaggedArray(const string& input) {
        data.resize(4);
        for (char ch : input) {
            if (isVowel(ch))          addUnique(0, ch);
            else if (isConsonant(ch)) addUnique(1, ch);
            else if (isDigit(ch))     addUnique(2, ch);
            else if (isSymbol(ch))    addUnique(3, ch);
        }
    }

    //служебные методы
    int rows() const { return (int)data.size(); }
    int cols(int i) const {
        if (i < 0 || i >= (int)data.size()) return 0;
        return (int)data[i].size();
    }

    void addUnique(int rowIdx, char c) {
        if (rowIdx < 0 || rowIdx >= (int)data.size()) return;
        char lower = toLowerRus(c);
        for (char x : data[rowIdx])
            if (x == lower) return;   
        data[rowIdx].push_back(lower);
    }
    //   Переопределение обращения по индексам A[i][j]
    RowProxy operator[](int i) {
        if (i < 0 || i >= (int)data.size())
            throw out_of_range("Индекс строки вне диапазона");
        return RowProxy(data[i]);
    }
    const RowProxy operator[](int i) const {
        if (i < 0 || i >= (int)data.size())
            throw out_of_range("Индекс строки вне диапазона");
        return RowProxy(const_cast<vector<char>&>(data[i]));
    }
    //   delete(строка, номер) — удаление по двойному индексу
    bool deleteAt(int row, int num) {
        if (row < 0 || row >= (int)data.size()) return false;
        if (num < 0 || num >= (int)data[row].size()) return false;
        data[row].erase(data[row].begin() + num);
        return true;
    }
    //   delete(item) — удаление по значению (во всех строках)
    bool deleteItem(char item) {
        char lower = toLowerRus(item);
        bool removed = false;
        for (auto& row : data) {
            auto it = find(row.begin(), row.end(), lower);
            if (it != row.end()) {
                row.erase(it);
                removed = true;
            }
        }
        return removed;
    }
    //   operator+ : поэлементное сложение / конкатенация
    JaggedArray operator+(const JaggedArray& other) const {
        JaggedArray res;

        // если обе — «числовые» (массивы из цифр), то складываем
        bool numeric = isNumericArray() && other.isNumericArray();

        if (numeric) {
            // 1) собираем числа из каждой строки как вектор цифр
            //    (предполагается, что в каждой строке может лежать число
            //     поразрядно). Поэлементно складываем.
            res.data.resize(max(data.size(), other.data.size()));
            for (size_t i = 0; i < res.data.size(); ++i) {
                int n1 = (i < data.size()) ? (int)data[i].size() : 0;
                int n2 = (i < other.data.size()) ? (int)other.data[i].size() : 0;
                int n = max(n1, n2);
                res.data[i].resize(n);
                for (int j = 0; j < n; ++j) {
                    int a = (j < n1) ? (data[i][j] - '0') : 0;
                    int b = (j < n2) ? (other.data[i][j] - '0') : 0;
                    int sum = a + b;
                    if (sum > 9) sum -= 10;    // перенос опущен для наглядности
                    res.data[i][j] = (char)('0' + sum);
                }
            }
        }
        else {
            // 2) иначе — конкатенация строк (для символьных массивов)
            res.data.resize(max(data.size(), other.data.size()));
            for (size_t i = 0; i < res.data.size(); ++i) {
                if (i < data.size())
                    res.data[i].insert(res.data[i].end(),
                        data[i].begin(), data[i].end());
                if (i < other.data.size())
                    res.data[i].insert(res.data[i].end(),
                        other.data[i].begin(), other.data[i].end());
            }
        }
        return res;
    }
    //   operator++ : ++ для чисел / сдвиг символов по коду
    JaggedArray& operator++() {          // префиксный
        for (auto& row : data) {
            for (auto& c : row) {
                if (c >= '0' && c <= '9')
                    c = (c == '9') ? '0' : (char)(c + 1);   // обычный ++
                else
                    c = (char)((unsigned char)c + 1);       // сдвиг по коду
            }
        }
        return *this;
    }

    JaggedArray operator++(int) {        // постфиксный
        JaggedArray tmp = *this;
        ++(*this);
        return tmp;
    }
    //   Сортировка внутри строк массива
    void sortRows() {
        for (auto& row : data)
            sort(row.begin(), row.end());
    }
    //   Функция просмотра строка-цвет
    void print() const {
        int colors[4] = { RED, BLUE, GREEN, YELLOW };
        cout << "Зубчатый массив:" << endl;
        for (size_t i = 0; i < data.size(); ++i) {
            color(colors[i % 4]);
            cout << "Строка " << i << ": ";
            for (char c : data[i]) cout << c << " ";
            color(WHITE);
            cout << endl;
        }
    }

    //вспомогательный метод 
    bool isNumericArray() const {
        for (const auto& row : data)
            for (char c : row)
                if (!(c >= '0' && c <= '9')) return false;
        return true;
    }
};
int main() {
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    setlocale(LC_ALL, "Russian");

    cout << "Введите строку:" << endl;
    string input;
    getline(cin, input);
    if (input.length() > 50) input = input.substr(0, 50);

    // 1) создаём объект класса из строки
    JaggedArray A(input);
    cout << "\n--- Исходный массив ---" << endl;
    A.print();

    // 2) демонстрация A[i][j]
    cout << "\nA[0][0] = " << A[0][0] << endl;
    A[0][0] = 'Z';                       // запись через двойной индекс
    cout << "После A[0][0]='Z':" << endl;
    A.print();

    // 3) delete(строка, номер)
    cout << "\nУдаляем A[1][0]..." << endl;
    A.deleteAt(1, 0);
    A.print();

    // 4) delete(item)
    cout << "\nУдаляем значение 'а' (если есть)..." << endl;
    A.deleteItem((char)0xE0);            // 'а' в CP1251
    A.print();

    // 5) operator+
    JaggedArray B(input);
    cout << "\n--- B ---" << endl;
    B.print();
    JaggedArray C = A + B;
    cout << "\n--- C = A + B (конкатенация) ---" << endl;
    C.print();

    // 6) operator++
    cout << "\n--- ++A ---" << endl;
    ++A;
    A.print();

    // 7) сортировка внутри строк
    cout << "\n--- Сортировка внутри строк ---" << endl;
    C.sortRows();
    C.print();

    // 8) числа: оператор + как поэлементное сложение
    JaggedArray N1("123");
    JaggedArray N2("456");
    cout << "\n--- Числовой пример N1 + N2 ---" << endl;
    N1.print();
    N2.print();
    JaggedArray N3 = N1 + N2;
    N3.print();

    // 9) ++ на числах — обычный инкремент
    cout << "\n--- ++N1 ---" << endl;
    ++N1;
    N1.print();

    return 0;
}
